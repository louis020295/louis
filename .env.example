# GEMINI_API_KEY: Required for server-side Gemini AI explanation (/api/explain).
# AI Studio automatically injects this at runtime from user secrets.
# NEVER expose this key in browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Custom Binance USDⓈ-M Futures public REST base URL
BINANCE_FAPI_BASE_URL="https://fapi.binance.com"

# Optional (Phase 2): Telegram Notification Bot credentials (server-side only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional (Phase 2): TradingView Webhook verification secret (server-side only)
TRADINGVIEW_WEBHOOK_SECRET=""

# Optional shared public-HTTP budget (counts every real exchange request)
# RADAR_HTTP_MAX_REQUESTS=80
# RADAR_HTTP_WINDOW_MS=10000
# RADAR_BINANCE_WEIGHT_SOFT_LIMIT=1800
# RADAR_BINANCE_WEIGHT_COOLDOWN_MS=15000
# RADAR_BYBIT_BAN_COOLDOWN_MS=600000
# RADAR_HTTP_MAX_RETRY_AFTER_MS=30000
