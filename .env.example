# GEMINI_API_KEY: Required for server-side Gemini AI explanation (/api/explain).
# AI Studio automatically injects this at runtime from user secrets.
# NEVER expose this key in browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL is currently unused by the server / scan / scheduler runtime
# (kept only so older AI Studio / hosting templates do not break).
# APP_URL="MY_APP_URL"

# Optional: Custom Binance USDⓈ-M Futures public REST base URL
BINANCE_FAPI_BASE_URL="https://fapi.binance.com"

# Optional: Telegram Notification Bot credentials (server-side only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional: Discord Webhook URL for notification dispatch (server-side only)
DISCORD_WEBHOOK_URL=""

# TRADINGVIEW_WEBHOOK_SECRET is currently unused by the runtime.
# TradingView notification previews go through the in-app dry-run / sandbox
# adapters and do not read this variable. Left commented so operators do not
# think a webhook secret is wired up.
# TRADINGVIEW_WEBHOOK_SECRET=""

# Optional: 24/7 Deployment Configuration
# Persistent SQLite file path (mount a persistent volume here for Docker/Cloud Run/VPS)
RADAR_SQLITE_PATH="./data/radar_phase2.sqlite"
# Set to "true" to automatically enable hourly Auto-Backtest batches on boot
AUTO_BACKTEST_ENABLED="true"
# Listening port (defaults to 3000)
PORT="3000"


# Optional: Background scheduler SMC coverage.
# Default (unset / "all" / "0") = every eligible symbol in the radar universe
# (full USDT-M market). Set a positive integer to cap the set
# (radar long/short first, then by score). The scheduler uses SmcBatchScanService
# rate limits (1200 req/min, HTTP concurrency 8, eval concurrency 2).
# Cost: ~5 REST weight units per symbol (4 kline TFs + OI); 522 symbols ≈ 2610
# weight, ~2.2 min theoretical / ~3.5–4 min observed per full cycle.
# SCHEDULER_SMC_TOP_N="all"
